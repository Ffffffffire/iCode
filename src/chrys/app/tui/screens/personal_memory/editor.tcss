PersonalMemoryEditor {
    align: center middle;
    background: $background 60%;
}
PersonalMemoryEditor #memory-editor {
    width: 88%; max-width: 100; height: 90%; max-height: 38;
    border: round $tui-border-primary $border-opacity; border-title-color: $tui-border-title-primary;
    border-title-style: bold; background: $surface; padding: 1 2;
}
PersonalMemoryEditor #memory-editor-fields { height: 1fr; scrollbar-size: 1 1; }
PersonalMemoryEditor #memory-edit-meta { height: auto; }
PersonalMemoryEditor #memory-edit-kind { width: 1fr; }
PersonalMemoryEditor #memory-edit-project { width: 1fr; }
PersonalMemoryEditor .memory-edit-label { height: 1; margin-top: 1; color: $primary; }
PersonalMemoryEditor #memory-edit-content { height: 7; min-height: 4; }
PersonalMemoryEditor #memory-edit-buttons { height: 3; align-horizontal: right; margin-top: 1; }
PersonalMemoryEditor #memory-edit-buttons Button { margin-left: 1; }
PersonalMemoryEditor #memory-edit-error { height: auto; color: $error; }
