PersonalMemoryScreen {
    align: center middle;
    background: $background 50%;
}
PersonalMemoryScreen #personal-memory {
    width: 96%; max-width: 154; height: 94%;
    border: round $tui-border-primary $border-opacity; border-title-color: $tui-border-title-primary; border-title-style: bold;
    background: $surface; padding: 0 1;
}
PersonalMemoryScreen #memory-toolbar { height: 3; margin-top: 1; }
PersonalMemoryScreen #memory-mode { width: 28; }
PersonalMemoryScreen #memory-capture { width: 1fr; }
PersonalMemoryScreen #memory-new { width: 12; min-width: 8; }
PersonalMemoryScreen #memory-counts { height: 1; color: $text-muted; margin: 0 1 1 1; }
PersonalMemoryScreen #memory-recall-query { height: auto; max-height: 2; color: $text-muted; margin: 0 1 1 1; }
PersonalMemoryScreen #memory-body { height: 1fr; }
PersonalMemoryScreen #memory-index { width: 34%; min-width: 26; margin-right: 2; }
PersonalMemoryScreen #memory-filters { height: auto; }
PersonalMemoryScreen #memory-search { margin-bottom: 0; }
PersonalMemoryScreen #memory-view { margin-bottom: 1; }
PersonalMemoryScreen #memory-list { height: 1fr; border: none; background: $panel; }
PersonalMemoryScreen #memory-detail { width: 1fr; height: 1fr; scrollbar-size: 1 1; padding: 0 1; }
PersonalMemoryScreen #memory-title { height: auto; text-style: bold; color: $primary; margin-bottom: 1; }
PersonalMemoryScreen #memory-meta { height: auto; color: $secondary; margin-bottom: 1; }
PersonalMemoryScreen #memory-match { height: auto; color: $warning; margin-bottom: 1; }
PersonalMemoryScreen #memory-content { height: auto; margin-bottom: 1; }
PersonalMemoryScreen .memory-section {
    height: auto; border: round $tui-border-secondary 50%; border-title-color: $secondary;
    padding: 0 1; margin-bottom: 1;
}
PersonalMemoryScreen #memory-source { color: $text-muted; border: round $tui-border-primary 35%; }
PersonalMemoryScreen #memory-history { height: auto; }
PersonalMemoryScreen #memory-history-text { height: auto; }
PersonalMemoryScreen #memory-error { height: auto; color: $error; }
PersonalMemoryScreen #memory-actions { height: 3; grid-size: 6; grid-gutter: 0 1; margin-top: 1; }
PersonalMemoryScreen #memory-actions Button { width: 1fr; min-width: 7; }
PersonalMemoryScreen.-compact #memory-body { layout: vertical; }
PersonalMemoryScreen.-compact #memory-counts { margin-bottom: 0; }
PersonalMemoryScreen.-compact #memory-recall-query { max-height: 1; margin-bottom: 0; }
PersonalMemoryScreen.-compact #memory-index { width: 100%; height: 5; min-height: 5; margin: 0; }
PersonalMemoryScreen.-compact #memory-filters { layout: horizontal; height: 3; }
PersonalMemoryScreen.-compact #memory-filters > * { width: 1fr; }
PersonalMemoryScreen.-compact #memory-index Select { margin: 0; }
PersonalMemoryScreen.-compact #memory-detail { width: 100%; height: 1fr; }
PersonalMemoryScreen.-compact #memory-title,
PersonalMemoryScreen.-compact #memory-meta,
PersonalMemoryScreen.-compact #memory-match { margin-bottom: 0; }
PersonalMemoryScreen.-compact #memory-toolbar { height: auto; }
PersonalMemoryScreen.-compact #memory-mode { width: 24; }
PersonalMemoryScreen.-compact #memory-actions { height: 6; grid-size: 3; }
