PersonalMemoryScreen {
    align: center middle;
    background: $background 40%;
}
PersonalMemoryScreen #personal-memory {
    width: 92%; max-width: 120; height: 85%; max-height: 42;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $tui-border-title-primary; border-title-style: bold;
    background: $surface; padding: 0;
}
PersonalMemoryScreen #memory-toolbar { height: 3; padding: 1 1; }
PersonalMemoryScreen #memory-search {
    height: 1; width: 1fr; border: none; padding: 0 1; margin-right: 2;
    background: $foreground 5%;
}
PersonalMemoryScreen #memory-search:focus { background: $foreground 10%; }
PersonalMemoryScreen Button { height: 1; width: auto; min-width: 7; border: none; padding: 0 2; }
PersonalMemoryScreen #memory-view { height: 2; }
PersonalMemoryScreen #memory-view Tab { padding: 0 2; }
PersonalMemoryScreen #memory-body { height: 1fr; }
PersonalMemoryScreen #memory-index {
    width: 30%; min-width: 22; height: 1fr;
    border-right: solid $tui-border-foreground 15%;
}
PersonalMemoryScreen #memory-list {
    height: 1fr; border: none; padding: 0 0 0 1;
    scrollbar-size: 1 1; scrollbar-gutter: stable;
}
PersonalMemoryScreen #memory-detail {
    width: 1fr; height: 1fr; scrollbar-size: 1 1; scrollbar-gutter: stable; padding: 1 2;
}
PersonalMemoryScreen #memory-title { height: auto; text-style: bold; color: $primary; }
PersonalMemoryScreen #memory-meta { height: auto; color: $text-muted; margin-bottom: 1; }
PersonalMemoryScreen #memory-content { height: auto; margin-bottom: 1; }
PersonalMemoryScreen #memory-replacement { height: auto; color: $warning; margin-bottom: 1; }
PersonalMemoryScreen .memory-section {
    height: auto; border-left: thick $tui-border-secondary 45%; border-top: none;
    border-title-color: $text-muted; padding: 0 1; margin-bottom: 1;
}
PersonalMemoryScreen Collapsible { border: none; padding: 0; margin: 0; }
PersonalMemoryScreen Collapsible > Contents { padding: 0 1 1 1; }
PersonalMemoryScreen #memory-source,
PersonalMemoryScreen #memory-match,
PersonalMemoryScreen #memory-recall-query,
PersonalMemoryScreen #memory-recall-tip,
PersonalMemoryScreen #memory-history-text { height: auto; color: $text-muted; }
PersonalMemoryScreen #memory-recall-tip { margin-bottom: 1; }
PersonalMemoryScreen #memory-error { height: auto; color: $error; padding: 0 1; }
PersonalMemoryScreen #memory-settings {
    height: 2; border-top: solid $tui-border-foreground 15%; padding: 0 1;
}
PersonalMemoryScreen #memory-mode { width: 25; height: auto; margin-right: 2; }
PersonalMemoryScreen #memory-settings SelectCurrent {
    height: 1; border: none; padding: 0 1; background: $foreground 8%;
}
PersonalMemoryScreen #memory-settings SelectOverlay {
    border: round $tui-border-primary $border-opacity; max-height: 8;
}
PersonalMemoryScreen #memory-capture {
    height: auto; width: 1fr;
}
PersonalMemoryScreen #memory-actions { height: 3; padding: 1 1; }
PersonalMemoryScreen #memory-actions Button { margin-right: 1; }
PersonalMemoryScreen #memory-action-spacer { width: 1fr; height: 1; }
PersonalMemoryScreen.-compact #personal-memory { width: 100%; height: 96%; }
PersonalMemoryScreen.-compact #memory-body { layout: vertical; }
PersonalMemoryScreen.-compact #memory-index {
    width: 100%; height: 4; min-height: 3; border-right: none;
    border-bottom: solid $tui-border-foreground 15%;
}
PersonalMemoryScreen.-compact #memory-detail { width: 100%; height: 1fr; padding: 1; }
PersonalMemoryScreen.-compact #memory-view Tab { padding: 0 1; }
PersonalMemoryScreen.-compact #memory-actions Button { padding: 0 1; min-width: 5; }
PersonalMemoryScreen.-compact #memory-mode { width: 23; margin-right: 1; }
